# Deny by default so local files never enter the remote build context.
**

# Dependency manifests
!package.json
!package-lock.json

# Production build configuration
!tsconfig.json
!next.config.mjs
!postcss.config.mjs

# Application source and public assets
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!public/
!public/**

# Never re-include secrets accidentally placed under an allowed directory.
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
