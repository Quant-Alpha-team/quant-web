## backend API settings
API_BASE_URL=http://127.0.0.1:8000
API_TOKEN="<your_api_token>"
API_AUTH_DISABLED=false

## request / dataset tuning
API_TIMEOUT_SECONDS=15
API_SYNC_TIMEOUT_SECONDS=180
API_PAGE_SIZE=500
DASHBOARD_API_CONCURRENCY=4
API_MAX_EXEC_ROWS=5000
API_MAX_PERF_ROWS=5000
API_MAX_PNL_ROWS=5000
API_MAX_POSITION_ROWS=5000

## startup behavior
# false: start UI even if backend API is down
# true: fail fast when API preflight fails
API_PREFLIGHT_STRICT=false

## logging settings
TZ=America/New_York
LOG_DIR=logs
LOG_FILE=dashboard.log
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
