## backend API settings
API_BASE_URL=http://127.0.0.1:8000
API_TOKEN="<your_api_token>"
API_AUTH_DISABLED=false

## request / dataset tuning
API_TIMEOUT_SECONDS=15
API_SYNC_TIMEOUT_SECONDS=900
API_PAGE_SIZE=500
DASHBOARD_API_CONCURRENCY=4
API_MAX_EXEC_ROWS=5000
API_MAX_PERF_ROWS=5000
API_MAX_PNL_ROWS=5000
API_MAX_POSITION_ROWS=5000

## startup behavior
# false: start UI even if backend API is down
# true: fail fast when API preflight fails
API_PREFLIGHT_STRICT=false

## request guard
# host names (any port) the dashboard answers; other Host headers get 403
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# true only behind a reverse proxy that overwrites X-Forwarded-Host/-Proto
WEB_TRUST_PROXY_HEADERS=false

## logging settings
TZ=America/New_York
LOG_DIR=logs
LOG_FILE=dashboard.log
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7

# Existing explicit API_SYNC_TIMEOUT_SECONDS=180 overrides should be increased for the full pipeline; the default is 900 seconds.

# API_SYNC_TIMEOUT_SECONDS is the application abort budget, not a guarantee that the connection remains open: runtime or upstream header timeouts may end it earlier. After a sync transport failure, the server checks reconciliation status and the dashboard polls an active lease without resubmitting the POST. Idle or unavailable status preserves the failure; lease release does not imply success.
